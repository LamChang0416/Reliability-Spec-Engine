    "Schedule D - Stacked Vibration (推疊振動)": {
      "Vibration under Compressive Load (帶載振動)": {
        "parameters": {
          "Standard": "ASTM D4169-23",
          "Description_ZH": "模擬底層包裹在運輸途中承受上方貨物重量時的動態振動破壞力。",
          "Description_EN": "Simulates dynamic bottom-load compression during vehicle vibration.",
          "Top Load Formula": "L = W * ((H-h)/h) * F",
          "Variables": "W: Package weight, H: Stack height, h: Package height"
        },
        "tests": [
          {
            "Assurance Level": "I",
            "Safety Factor (F)": "1.0",
            "Vibration Profile": "Use Level I PSD"
          },
          {
            "Assurance Level": "II",
            "Safety Factor (F)": "0.7",
            "Vibration Profile": "Use Level II PSD"
          },
          {
            "Assurance Level": "III",
            "Safety Factor (F)": "0.5",
            "Vibration Profile": "Use Level III PSD"
          }
        ]
      }
    },
    "Schedule B/C - Stacking (靜態推碼抗壓)": {
      "Machine Apply and Release/Hold (抗壓機壓放試驗)": {
        "parameters": {
          "Standard": "ASTM D4169-23",
          "Description_ZH": "驗證紙箱與包裝材長時間堆疊在外箱上的靜態抗壓強度。使用公式計算目標下壓力 (Load)。",
          "Description_EN": "Static compression strength evaluation using a testing machine.",
          "Compression Formula": "Load (L) = W * ((H-h)/h) * F",
          "W": "Weight of one package",
          "H": "Maximum stacking height in transit or storage",
          "h": "Height of one package"
        },
        "tests": [
          {
            "Assurance Level & Material": "Level I - Corrugated Box",
            "Safety Factor (F)": "8.0",
            "Application": "Highest severity storage"
          },
          {
            "Assurance Level & Material": "Level II - Corrugated Box",
            "Safety Factor (F)": "4.5",
            "Application": "Standard transit warehouse stacking"
          },
          {
            "Assurance Level & Material": "Level III - Corrugated Box",
            "Safety Factor (F)": "3.0",
            "Application": "Short term or low risk stacking"
          }
        ]
      }
    },
    "Schedule F - Loose Load Vibration (鬆散荷載振動)": {
      "Loose Load Bounce (跳動測試)": {
        "parameters": {
          "Standard": "ASTM D4169-23",
          "Description_ZH": "模擬未固定的包裹在卡車車廂內跳動與互相碰撞。",
          "Description_EN": "Simulates unrestrained package bouncing and colliding in a vehicle.",
          "Frequency": "Typically ~4-5 Hz (rotary or vertical synchronous motion)",
          "Duration": "Depends on DC, typically 40 to 120 minutes"
        },
        "tests": [
          {
            "Test": "Bounce",
            "Condition": "Machine speed adjusted so package leaves table by ~1.6mm (1/16 in)"
          }
        ]
      }
    }
  },
  "DC 3: Single package environment (單一小包裹環境)": {
    "Schedule A - Handling (人工落摔)": {
      "Drop Test (跌落測試)": {
        "parameters": {
          "Standard": "ASTM D4169-23",
          "Description_ZH": "模擬單獨寄送的包裹摔落機率較高，適用於電商或零售單件出貨。",
          "Description_EN": "Single parcel drop simulation, commonly used for retail shipments."
        },
        "tests": [
          {
            "Hazard": "Manual Handling",
            "Action": "Same drops as defined in General Schedule A but typically tested at Level I or II"
          }
        ]
      }
    },
    "Schedule I - Low Pressure (低氣壓/空運)": {
      "Altitude Simulation (高海拔模擬)": {
        "parameters": {
          "Standard": "ASTM D4169-23",
          "Description_ZH": "模擬飛機貨艙未加壓環境，驗證密封袋、液體瓶罐是否會破裂或滲漏。",
          "Description_EN": "Un-pressurized cargo hold simulation checking for seal failure.",
          "Test Pressure": "Usually equivalent to 10,000 to 15,000 ft altitude",
          "Duration": "60 minutes"
        },
        "tests": [
          {
            "Requirement": "Maintain test pressure",
            "Action": "Monitor for ballooning, leakage, or burst"
          }
        ]
      }
    }
  },
  "DC 13: Air and mixed freight (空運與公路混合)": {
    "Schedule A, E, F, I (綜合排程)": {
      "Air Delivery Profile (空運物流連貫測試)": {
        "parameters": {
          "Standard": "ASTM D4169-23",
          "Description_ZH": "最常見的外銷空運測試循環，包含跌落、空運隨機振動、卡車隨機振動與低壓測試的組合拳。",
          "Description_EN": "Standard sequence for international air freight including drops, air vib, truck vib, and altitude."
        },
        "tests": [
          {
            "Sequence": "1. Schedule A",
            "Action": "Handling Drops (First half)"
          },
          {
            "Sequence": "2. Schedule C",
            "Action": "Truck Random Vibration (e.g. Level II, 60 mins)"
          },
          {
            "Sequence": "3. Schedule I",
            "Action": "Low Pressure (Altitude)"
          },
          {
            "Sequence": "4. Schedule C",
            "Action": "Air Random Vibration (e.g. Level II, 120 mins)"
          },
          {
            "Sequence": "5. Schedule A",
            "Action": "Handling Drops (Second half on different faces)"
          }
        ]
      }
    }
  },
  "DC 14: LTL motor freight (零擔物流運輸)": {
    "Schedule A, E, J (LTL 綜合排程)": {
      "LTL Profile (零擔卡車物流連貫測試)": {
        "parameters": {
          "Standard": "ASTM D4169-23",
          "Description_ZH": "模擬電商大件或打棧板商品透過 LTL (Less-Than-Truckload) 零擔物流寄送。包含額外的 Schedule J 集中衝擊。",
          "Description_EN": "LTL motor freight sequence, includes Concentrated Impact (Schedule J) for puncturing hazards."
        },
        "tests": [
          {
            "Sequence": "1. Schedule A",
            "Action": "Handling Drops"
          },
          {
            "Sequence": "2. Schedule J",
            "Action": "Concentrated Impact (to simulate forks or other freight hitting it)"
          },
          {
            "Sequence": "3. Schedule E",
            "Action": "Truck Random Vibration"
          },
          {
            "Sequence": "4. Schedule A",
            "Action": "Handling Drops"
          }
        ]
      }
    }
  }
}