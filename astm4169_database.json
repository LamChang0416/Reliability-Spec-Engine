  "DC 1: General schedule (一般寄送)": {
    "Schedule A - Handling (人工搬運跌落)": {
      "Drop Test (跌落測試)": {
        "parameters": {
          "Standard": "ASTM D4169-23",
          "Description_ZH": "模擬人工搬運與包裹上下貨時的摔落。分為三次不同高度層級的跌落，確保邊角與面受到衝擊。",
          "Description_EN": "Manual handling drop tests. Drop height is determined by package weight and assurance level.",
          "Drop Sequence": "One corner, one edge, then remaining faces."
        },
        "tests": [
          {
            "Weight": "0 - 9.1 kg (0 - 20 lb)",
            "Level I Height": "610 mm (24 in)",
            "Level II Height": "381 mm (15 in)",
            "Level III Height": "229 mm (9 in)"
          },
          {
            "Weight": "9.1 - 18.1 kg (20 - 40 lb)",
            "Level I Height": "533 mm (21 in)",
            "Level II Height": "330 mm (13 in)",
            "Level III Height": "229 mm (9 in)"
          },
          {
            "Weight": "18.1 - 27.2 kg (40 - 60 lb)",
            "Level I Height": "457 mm (18 in)",
            "Level II Height": "305 mm (12 in)",
            "Level III Height": "229 mm (9 in)"
          },
          {
            "Weight": "27.2 - 45.4 kg (60 - 100 lb)",
            "Level I Height": "381 mm (15 in)",
            "Level II Height": "229 mm (9 in)",
            "Level III Height": "178 mm (7 in)"
          },
          {
            "Weight": "Over 45.4 kg (Over 100 lb)",
            "Level I Height": "305 mm (12 in)",
            "Level II Height": "229 mm (9 in)",
            "Level III Height": "178 mm (7 in)"
          }
        ]
      }
    },
    "Schedule E - Vehicle Vibration (車輛隨機振動)": {
